<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>简历下载 — 求职管理</title>
  <link rel="stylesheet" href="../assets/style.css?v={{ asset_version }}">
</head>
<body>
<header class="site-header">
  <h1>简历下载</h1>
  <button class="nav-toggle" type="button" aria-expanded="false" aria-label="切换导航">菜单</button>
  <nav>
    <a href="../index.html">总览</a>
    <a href="../insights.html">洞察</a>
    <a href="../jobs/index.html">岗位</a>
    <a href="../weekly/index.html">周报</a>
    <a href="index.html" class="active">简历下载</a>
  </nav>
  <span class="updated">更新：{{ generated_at }}</span>
</header>

<main>
  <section class="card">
    <h2>可下载简历</h2>
    {% if resume_entries %}
    <table class="timeline-table table-desktop">
      <thead><tr><th>类型</th><th>文件</th><th>状态</th><th>下载</th></tr></thead>
      <tbody>
      {% for entry in resume_entries %}
        <tr>
          <td>{{ entry.label }}</td>
          <td><code>{{ entry.name }}</code></td>
          <td>
            {% if entry.available %}
            <span class="badge ok">可下载</span>
            {% else %}
            <span class="badge warn">未生成</span>
            {% endif %}
          </td>
          <td>
            {% if entry.available %}
              <a class="btn secondary" href="{{ entry.name }}" target="_blank">下载 PDF</a>
            {% else %}
              <span class="empty">请先本地或 CI 构建</span>
            {% endif %}
          </td>
        </tr>
      {% endfor %}
      </tbody>
    </table>

    <div class="gallery-list mobile-only">
      {% for entry in resume_entries %}
      <article class="gallery-card">
        <h3>{{ entry.label }}</h3>
        <p class="gallery-meta"><strong>文件：</strong><code>{{ entry.name }}</code></p>
        <p class="gallery-meta"><strong>状态：</strong>
          {% if entry.available %}
          <span class="badge ok">可下载</span>
          {% else %}
          <span class="badge warn">未生成</span>
          {% endif %}
        </p>
        <div class="gallery-actions">
          {% if entry.available %}
            <a class="btn secondary" href="{{ entry.name }}" target="_blank">下载 PDF</a>
          {% else %}
            <span class="empty">请先构建</span>
          {% endif %}
        </div>
      </article>
      {% endfor %}
    </div>
    {% else %}
    <p class="empty">暂无简历产物。执行 <code>make full</code> 或 <code>make job JOB=xxx</code> 后重试。</p>
    {% endif %}
  </section>
</main>

<footer>生成于 {{ generated_at }} · resume-forge</footer>
<script src="../assets/nav.js?v={{ asset_version }}"></script>
</body>
</html>
